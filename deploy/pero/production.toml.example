# Private deployment overrides. Copy outside Git, e.g. local/deploy/pero/config/production.toml.
# The packager overlays these values onto the current source default.toml.
[database]
url = "postgres://postgres:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/pero"
encrypt_key = "REPLACE_DATABASE_ENCRYPTION_KEY"

[redis]
url = "redis://127.0.0.1:6379/0"

[oidc]
issuer = "https://auth.example.com"

[sso]
base_url = "https://auth.example.com"
cookie_secure = true
cookie_signing_secret = "REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS"

[password_reset]
signing_key = "REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS"

[frontend]
static_dir = "prd/ui/static"

[log]
dir = "./logs/prd"

# Optional direct delivery channels. Missing/invalid settings do not block startup;
# requests requiring an unavailable channel return 503. See docs/application-portal-and-delivery.md.
# [notification.smtp]
# host = "smtp.example.com"
# port = 587
# security = "starttls" # or "tls" with port 465
# username = "notify@example.com"
# password = "REPLACE_WITH_SMTP_PASSWORD"
# from = "Pero <notify@example.com>"
# [notification.sms]
# account_sid = "AC_REPLACE_WITH_32_HEX_DIGITS"
# auth_token = "REPLACE_WITH_TWILIO_TOKEN"
# from = "+12025550123"
