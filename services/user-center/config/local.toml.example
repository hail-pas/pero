# Local development only. Copy to local.toml and supply private values.
# Only environment-specific overrides belong here.

[database]
url = "postgres://pero:CHANGE_ME@127.0.0.1:5432/pero"
encrypt_key = "" # Set a random encryption key.

[redis]
url = "redis://127.0.0.1:6379/0"

[oidc]
issuer = "http://localhost:8080"

[sso]
base_url = "http://localhost:8080"
cookie_secure = false
cookie_signing_secret = "" # Set at least 32 random bytes.

[password_reset]
signing_key = "" # Set a different secret of at least 32 random bytes.

[frontend]
static_dir = "../../frontend/dist"

# Optional notification settings are documented in default.toml.
